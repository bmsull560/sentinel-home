# External Secrets Operator manifest template.
# Install External Secrets Operator in the cluster, then apply this manifest
# so the app can consume AWS Secrets Manager secrets as Kubernetes Secrets.
#
# Replace:
#   - ACCOUNT_ID with your AWS account ID
#   - us-east-1 with your AWS region
#   - The secret name pattern if it differs from Terraform output.

apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: sentinel-home-secrets
  namespace: sentinel-home
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: aws-secrets-manager
  target:
    name: sentinel-home-secrets
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: Opaque
      data:
        DATABASE_URL: "{{ .db_url }}"
        JWT_SECRET: "{{ .jwt_secret }}"
  data:
    - secretKey: db_url
      remoteRef:
        key: sentinel-home/ENV/rds-url
    - secretKey: jwt_secret
      remoteRef:
        key: sentinel-home/ENV/jwt-secret
